+TEST(LinuxDisplayGeometryTest, PrefersTheCompositorDesktopOverCapturedOutputs) {
+  platf::desktop_geometry_t compositor_desktop;
+  compositor_desktop.add({.width = 1920, .height = 1080, .logical_width = 1920, .logical_height = 1080});
+  compositor_desktop.add({.offset_y = -1080, .width = 1920, .height = 1080, .logical_width = 1920, .logical_height = 1080});
+
+  platf::desktop_geometry_t capture_desktop;
+  capture_desktop.add({.width = 1920, .height = 1080, .logical_width = 1920, .logical_height = 1080});
+
+  const auto bounds = platf::absolute_input_desktop(compositor_desktop.bounds(), capture_desktop.bounds());
+  EXPECT_EQ(bounds.offset_x, 0);
+  EXPECT_EQ(bounds.offset_y, -1080);
+  EXPECT_EQ(bounds.width, 1920);
+  EXPECT_EQ(bounds.height, 2160);
+  EXPECT_EQ(bounds.logical_width, 1920);
+  EXPECT_EQ(bounds.logical_height, 2160);
+}
+
+TEST(LinuxDisplayGeometryTest, FallsBackToCapturedOutputsWithoutACompositorDesktop) {
+  platf::desktop_geometry_t capture_desktop;
+  capture_desktop.add({.offset_x = 1920, .width = 2560, .height = 1440, .logical_width = 1280, .logical_height = 720});
+
+  const platf::desktop_geometry_t empty_compositor_desktop;
+  const auto bounds = platf::absolute_input_desktop(empty_compositor_desktop.bounds(), capture_desktop.bounds());
+  EXPECT_EQ(bounds.offset_x, 1920);
+  EXPECT_EQ(bounds.offset_y, 0);
+  EXPECT_EQ(bounds.width, 2560);
+  EXPECT_EQ(bounds.height, 1440);
+  EXPECT_EQ(bounds.logical_width, 1280);
+  EXPECT_EQ(bounds.logical_height, 720);
+}
