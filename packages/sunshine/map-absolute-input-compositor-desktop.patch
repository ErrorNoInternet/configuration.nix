+TEST_F(InputGamepadSessionTest, TargetsAbsoluteMouseAtTheStreamedMonitorAboveAStackedDesktop) {
+  auto session_mail = std::make_shared<safe::mail_raw_t>();
+  auto stream_input = input::alloc(session_mail, "absolute-mouse-client");
+  ASSERT_NE(stream_input, nullptr);
+
+  const input::touch_port_t viewport {
+    {
+      .offset_x = 0,
+      .offset_y = 0,
+      .width = 1920,
+      .height = 1080,
+      .logical_width = 1920,
+      .logical_height = 1080,
+      .env_offset_x = 0,
+      .env_offset_y = -1080,
+    },
+    1920,
+    2160,
+    0.0F,
+    0.0F,
+    1.0F,
+    1.0F,
+    1920,
+    2160,
+  };
+
+  session_mail->event<input::touch_port_t>(mail::touch_port)->raise(viewport);
+
+  input::testing::send_absolute_mouse_packet(stream_input, 960, 0, 1920, 1080);
+  auto mouse_event = context().mouse->last_submitted_event();
+  EXPECT_EQ(mouse_event.kind, lvh::MouseEventKind::absolute_motion);
+  EXPECT_FLOAT_EQ(mouse_event.absolute_x, 960.0F);
+  EXPECT_FLOAT_EQ(mouse_event.absolute_y, 0.0F);
+  EXPECT_EQ(mouse_event.width, 1920);
+  EXPECT_EQ(mouse_event.height, 1080);
+  EXPECT_EQ(context().mouse_desktop.offset_y, -1080);
+  EXPECT_EQ(context().mouse_desktop.height, 2160);
+  EXPECT_EQ(context().mouse_viewport.offset_y, 0);
+  EXPECT_EQ(context().mouse_viewport.height, 1080);
+
+  input::testing::send_absolute_mouse_packet(stream_input, 960, 1079, 1920, 1080);
+  mouse_event = context().mouse->last_submitted_event();
+  EXPECT_FLOAT_EQ(mouse_event.absolute_y, 1079.0F);
+  EXPECT_EQ(mouse_event.height, 1080);
+}
